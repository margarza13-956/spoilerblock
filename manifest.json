{
  "manifest_version": 3,
  "name": "SpoilerBlock — Social Media Spoiler Blocker",
  "version": "1.0.0",
  "description": "Hides social media spoilers on YouTube, X, Reddit, Facebook, Instagram, Threads, TikTok, and Bluesky for movies, TV shows, and sports.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.reddit.com/*",
    "https://www.youtube.com/*",
    "https://www.instagram.com/*",
    "https://www.threads.net/*",
    "https://www.tiktok.com/*",
    "https://bsky.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://www.youtube.com/*",
        "https://www.instagram.com/*",
        "https://www.threads.net/*",
        "https://www.tiktok.com/*",
        "https://bsky.app/*"
      ],
      "js": [
        "spoiler-engine.js",
        "content.js"
      ],
      "css": [
        "spoilerblock.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
